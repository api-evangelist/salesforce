      "item": [
        {
          "id": "675d8014-69ff-4c6e-8b86-964bb4c843f2",
          "name": "Salesforce Passwordless Login - Initialize",
          "request": {
            "name": "Salesforce Passwordless Login - Initialize",
            "description": {
              "content": "Submits the passwordless login data to the init/passwordless/login endpoint and returns a request identifier. At the same time, an OTP is sent out to the end users via email or sms. Passwordless login data is passed in the request body, and is formatted with JSON, with 3 keys: `username`, `recaptcha`, and `verificationmethod`. All 3 keys are strings.\n\nThis request returns JSON, and includes an identifier (request identifier).",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "services",
                "auth",
                "headless",
                "init",
                "passwordless",
                "login"
              ],
              "host": [
                "login",
                "salesforce",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"recaptcha\": \"<string>\",\n  \"verificationmethod\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ae98b23f-b433-434f-b60b-292ee6ae5a42",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "services",
                    "auth",
                    "headless",
                    "init",
                    "passwordless",
                    "login"
                  ],
                  "host": [
                    "login",
                    "salesforce",
                    "com"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"<username>\",\n  \"recaptcha\": \"<recaptcha-token>\",\n  \"verificationmethod\": \"email or sms\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
