{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Logs API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Get Event Log File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/sobjects/EventLogFile/:id/LogFile",
            "params": [
              {
                "name": "id",
                "value": "abc123",
                "type": "path",
                "description": "Log event Id"
              }
            ]
          },
          "docs": "Salesforce Get Event Log File"
        }
      ]
    }
  ],
  "bundled": true
}