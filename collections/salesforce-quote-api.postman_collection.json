          "id": "e246bbe9-61ed-4a51-91f1-0cb8dff28558",
          "name": "Salesforce Create or Update Quote",
          "request": {
            "name": "Salesforce Create or Update Quote",
            "description": {
              "content": "This example creates a quote for the following products.\n\n- 5 Virtual Routers sold on a 1-year termed subscription at $35/item\n- 1 Bronze Service Level Agreement sold on an evergreen subscription at $10/month\n    \n\nSee [place quote](https://developer.salesforce.com/docs/revenue/subscription-management/references/quotes?meta=Create+or+update+a+quote+with+place+quote).",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "data",
                "v64.0",
                "commerce",
                "quotes",
                "actions",
                "place"
              ],
              "host": [
                "services"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
