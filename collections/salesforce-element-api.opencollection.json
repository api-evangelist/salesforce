{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Element API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Element",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Feed Element - Delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/chatter/feed-elements/:FEED_ELEMENT_ID",
            "params": [
              {
                "name": "FEED_ELEMENT_ID",
                "value": "500123",
                "type": "path"
              }
            ]
          },
          "docs": "Access, edit, or delete a feed element. Feed items are the only type of feed element that can be edited.\n\nhttps://developer.salesforce.com/docs/atlas.en-us.chatterapi.meta/chatterapi/connect_resources_feed_element_specific.htm"
        }
      ]
    }
  ],
  "bundled": true
}