            "headers": [
              {
                "name": "X-SFDC-Session",
                "value": "example_value"
              },
              {
                "name": "Accept-Encoding",
                "value": "example_value"
              },
              {
                "name": "Content-Encoding",
                "value": "example_value"
              }
            ]
          },
          "docs": "Salesforce Bulk Check Batch Status"
        }
      ]
    }
  ],
  "bundled": true
