    {
      "id": "99b4fc5b-9410-4c83-b866-949746b8f04d",
      "name": "Ingest Job Data",
      "description": {
        "content": "Operations for uploading CSV data to ingest jobs and retrieving job results (successful, failed, and unprocessed records).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d2ca2574-f5a3-4659-a605-a6bfb1d1d7cc",
          "name": "Salesforce Upload Job Data (csv)",
          "request": {
            "name": "Salesforce Upload Job Data (csv)",
            "description": {
              "content": "Uploads CSV data to an ingest job that is in the Open state. The CSV must include a header row matching the field API names for the object. Multiple upload calls can be made for the same job; data is appended. After uploading all data, close the job with PATCH /ingest/{jobId} to begin processing.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ingest",
                ":jobId",
                "batches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jobId",
                  "description": "(Required) The unique identifier of the Bulk API 2.0 job."
                },
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
          },
          "response": [
