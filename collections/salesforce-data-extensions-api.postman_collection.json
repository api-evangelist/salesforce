    {
      "id": "0efe743f-feb3-4acb-8414-3939f7b97476",
      "name": "Data Extensions",
      "description": {
        "content": "Operations for reading and writing rows in Marketing Cloud Data Extensions, which are custom tables for storing subscriber data and campaign data.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f57b74d0-abee-4be9-8310-98e7a4ee7c92",
          "name": "Get Data Extension rows",
          "request": {
            "name": "Get Data Extension rows",
            "description": {
              "content": "Retrieves rows from a Marketing Cloud Data Extension identified by its external key. Data Extensions are custom tables for storing subscriber data, lookup tables, or any structured data used in campaigns and journeys. Use the $pageSize and $page parameters to paginate through large data sets.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "v1",
                "async",
                "dataextensions",
                "key:{{key}}",
                "rows"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$pageSize",
                  "value": "50",
                  "description": "The number of rows to return per page. Defaults to 50."
                },
                {
                  "disabled": false,
                  "key": "$page",
                  "value": "1",
                  "description": "The page number to retrieve. Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "$orderBy",
                  "value": "<string>",
                  "description": "Field name and direction for sorting results (e.g., \"LastName ASC\" or \"CreatedDate DESC\").\n"
                }
              ],
              "variable": [
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
