{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Content API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Content",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce File Content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/connect/files/:FILE_ID/content",
            "params": [
              {
                "name": "FILE_ID",
                "value": "500123",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the binary content of the file, including references to external files. The content is streamed as the body of the response.\nhttps://developer.salesforce.com/docs/atlas.en-us.chatterapi.meta/chatterapi/connect_resources_files_content.htm"
        }
      ]
    }
  ],
  "bundled": true
}