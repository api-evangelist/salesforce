{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Parallel API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Parallel",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Get Parallel Results for a Query Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/jobs/query//resultPages",
            "headers": [
              {
                "name": "Content-Type",
                "value": "example_value"
              },
              {
                "name": "Accept",
                "value": "example_value"
              }
            ]
          },
          "docs": "Retrieves a set of up to 5 job results pages for parallel download."
        }
      ]
    }
  ],
  "bundled": true
}