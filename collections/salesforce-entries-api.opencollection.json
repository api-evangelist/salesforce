{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Entries API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Entries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Get Conversation Entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/connect/conversation/:conversationIdentifier/entries",
            "params": [
              {
                "name": "conversationIdentifier",
                "value": "example_value",
                "type": "path",
                "description": "Conversation identifier UUID"
              }
            ]
          },
          "docs": "Gets in-app messaging conversation entries.\nhttps://developer.salesforce.com/docs/atlas.en-us.chatterapi.meta/chatterapi/connect_resources_conversation_entries.htm"
        }
      ]
    }
  ],
  "bundled": true
}