          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/async/64.0/job//batch/:_batchId/result/:batchResultId",
            "headers": [
              {
                "name": "X-SFDC-Session",
