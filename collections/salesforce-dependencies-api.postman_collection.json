              "protocol": "https",
              "path": [
                "data",
                "v64.0",
                "connect",
                "business-rules",
                "expression-set",
                "version",
                ":expressionSetVersionId",
                "dependencies"
              ],
              "host": [
                "services"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
