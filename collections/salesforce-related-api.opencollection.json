{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Related API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Related",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Get Related List Actions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/ui-api/actions/record/:RECORD_ID/related-list/:RELATED_LIST_IDS",
            "params": [
              {
                "name": "RECORD_ID",
                "value": "500123",
                "type": "path",
                "description": "Record ID"
              },
              {
                "name": "RELATED_LIST_IDS",
                "value": "example_value",
                "type": "path",
                "description": "Optional. A related list name, or a comma-delimited list of related list names."
              }
            ]
          },
          "docs": "Get the actions on record detail pages."
        },
        {
          "info": {
            "name": "Salesforce Get Related List Record Actions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/ui-api/actions/record/:RECORD_ID/related-list-record/:RELATED_LIST_RECORD_IDS",
            "params": [
              {
                "name": "RECORD_ID",
                "value": "500123",
                "type": "path",
                "description": "Record ID"
              },
              {
                "name": "RELATED_LIST_RECORD_IDS",
                "value": "example_value",
                "type": "path",
                "description": "A related list record ID, or a comma-delimited list of related list record IDs."
              }
            ]
          },
          "docs": "Get the actions on records in related lists."
        }
      ]
    }
  ],
  "bundled": true
}