{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Bulk API 2.0 Abort Members API",
    "version": "v63.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Group Members",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/chatter/groups/:GROUP_ID/members",
            "params": [
              {
                "name": "userId",
                "value": "500123",
                "type": "query"
              },
              {
                "name": "GROUP_ID",
                "value": "500123",
                "type": "path"
              }
            ]
          },
          "docs": "Members of a specified group. Get the members and add a member to a group. To add a member, the context user must be the group owner or moderator.\n\nhttps://developer.salesforce.com/docs/atlas.en-us.chatterapi.meta/chatterapi/connect_resources_groups_GroupMembers.htm"
        }
      ]
    }
  ],
  "bundled": true
}