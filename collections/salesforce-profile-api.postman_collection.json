          "name": "Salesforce User Profile Feed Elements",
          "request": {
            "name": "Salesforce User Profile Feed Elements",
            "description": {
              "content": "Returns feed elements created when a user changes records that can be tracked in a feed, feed elements whose parent is the user, and feed elements that mention the user. This feed is different than the news feed, which returns more feed items, including group updates. You can post feed items to the user-profile feed. You can get another user’s user profile feed.\n\nhttps://developer.salesforce.com/docs/atlas.en-us.chatterapi.meta/chatterapi/connect_resource_feeds_user_profile.htm",
              "type": "text/plain"
            },
