          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/event/eventSchema/:SCHEMA_ID",
            "headers": [
              {
                "name": "Content-Type",
                "value": "example_value"
              }
