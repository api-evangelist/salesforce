              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Salesforce Forgot Password - Initialize"
        },
        {
          "info": {
            "name": "Salesforce Sobject User Password",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/sobjects/User/:USER_ID/password",
            "headers": [
              {
                "name": "Content-Type",
                "value": "example_value"
