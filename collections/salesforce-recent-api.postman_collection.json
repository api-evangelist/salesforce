          "name": "Salesforce Get Recently Viewed Records",
          "request": {
            "name": "Salesforce Get Recently Viewed Records",
            "description": {
              "content": "Returns a list of recently viewed and referenced records for the currently authenticated user. Records are ordered by the most recently viewed first. Useful for building recently visited navigation features in custom applications.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "recent"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "recentlyViewedCount",
                  "value": "200",
                  "description": "The number of recently viewed records to return. Defaults to 200. Maximum is 200.\n"
                }
              ],
              "variable": [
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
