  "item": [
    {
      "id": "10056b27-3386-43ae-86a5-d62ffba9c507",
      "name": "Lookups",
      "description": {
        "content": "Lookup field search endpoints",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "60b63a13-56bb-4da1-b0b7-ad1112eafffd",
          "name": "Salesforce Search Lookup Field Records",
          "request": {
            "name": "Salesforce Search Lookup Field Records",
            "description": {
              "content": "Returns matching records for a lookup field search. Used to populate the typeahead list in Lightning lookup components.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "lookups",
                ":objectApiName",
                ":fieldApiName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "searchTerm",
                  "value": "<string>",
                  "description": "(Required) The search text to match against lookup records"
                },
                {
                  "disabled": false,
                  "key": "dependentFieldBindings",
                  "value": "<string>",
                  "description": "JSON-encoded field value pairs for dependent picklist filtering"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "50",
                  "description": "Number of records per page"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "objectApiName",
                  "description": "(Required) The API name of the Salesforce object (e.g., Account, Contact, MyObject__c)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fieldApiName",
                  "description": "(Required) The API name of the lookup field"
                },
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a5c6a20b-e8a8-4dbb-86a5-75e634d1cd76",
              "name": "Lookup results retrieved successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "lookups",
                    ":objectApiName",
                    ":fieldApiName"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "searchTerm",
                      "value": "example_value"
                    },
                    {
                      "key": "dependentFieldBindings",
                      "value": "example_value"
                    },
                    {
                      "key": "pageSize",
                      "value": "50"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "objectApiName",
                      "description": "(Required) The API name of the Salesforce object (e.g., Account, Contact, MyObject__c)"
                    },
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "fieldApiName",
                      "description": "(Required) The API name of the lookup field"
                    },
                    {
                      "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                      "type": "any",
                      "value": "{{instance}}",
                      "key": "instance"
                    },
                    {
                      "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                      "type": "any",
                      "value": "{{version}}",
                      "key": "version"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"count\": 42,\n  \"lookupResults\": [\n    {\n      \"displayValue\": \"example_value\",\n      \"id\": \"abc123\",\n      \"name\": \"Example Title\"\n    }\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
