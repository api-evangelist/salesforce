    {
      "info": {
        "name": "Definition",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Prediction Definition Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v{version}/jobs/data/v64.0/smartdatadiscovery/predictionDefinitions/:PREDICTION_DEFINITION_ID",
            "params": [
              {
                "name": "PREDICTION_DEFINITION_ID",
                "value": "500123",
                "type": "path"
              }
            ]
          },
          "docs": "Get available prediction definitions."
        }
      ]
    }
  ],
  "bundled": true
