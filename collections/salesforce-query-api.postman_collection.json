        {
          "id": "335ca2cc-5096-43fd-b734-27f4104d2a82",
          "name": "Salesforce Get the Next Page of Query Results",
          "request": {
            "name": "Salesforce Get the Next Page of Query Results",
            "description": {
              "content": "Retrieves the next page of results from a paginated SOQL query. The queryId is obtained from the nextRecordsUrl in a previous query response. Continue calling this endpoint until the done field in the response is true.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query",
                ":queryId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "queryId",
                  "description": "(Required) The query ID token from the nextRecordsUrl of a previous query response.\n"
                },
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
