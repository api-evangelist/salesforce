        {
          "id": "6528b7ec-13ce-4574-86a5-123c1772e67b",
          "name": "Salesforce Request Product Information (no Bundles)",
          "request": {
            "name": "Salesforce Request Product Information (no Bundles)",
            "description": {
              "content": "Request information for two products that aren't bundles. For the first product, request only the information about the specified product selling model. For the second product, request information about all related product selling models.\n\nSee [Request Product Information](https://desktop.postman.com/?desktopVersion=10.13.6&webVersion=10.13.7-ui-230522-1730&userId=10709048&teamId=0).",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "data",
                "v64.0",
                "commerce",
                "catalog-products",
                "actions",
                "get-products"
              ],
              "host": [
                "services"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productContexts\": [\n    {\n      \"product2Id\": \"<string>\",\n      \"productSellingModelId\": \"<string>\"\n    },\n    {\n      \"product2Id\": \"<string>\",\n      \"productSellingModelId\": \"<string>\"\n    }\n  ],\n  \"fields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"retrievalType\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
