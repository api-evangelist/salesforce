{
  "item": [
    {
      "id": "651903d9-af90-4b62-884e-ab8f627444c0",
      "name": "Query Job Results",
      "description": {
        "content": "Operations for retrieving the results of completed query jobs as CSV data.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "26cb9d85-ef07-42c1-a01f-190e21484570",
          "name": "Salesforce Get Query Job Results",
          "request": {
            "name": "Salesforce Get Query Job Results",
            "description": {
              "content": "Returns the results of a completed query job as CSV data. The results may be paginated; check for a Sforce-Locator response header to retrieve subsequent pages by passing the locator value as a query parameter. Only available after the job reaches JobComplete state.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query",
                ":jobId",
                "results"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "maxRecords",
                  "value": "50000",
                  "description": "Maximum number of records to return in this response. Defaults to 50000. Use with the locator parameter to paginate through large result sets.\n"
                },
                {
                  "disabled": false,
                  "key": "locator",
                  "value": "<string>",
                  "description": "A locator token from the Sforce-Locator response header of a previous request to retrieve the next page of results.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jobId",
                  "description": "(Required) The unique identifier of the Bulk API 2.0 job."
                },
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c3fd7995-54b2-442e-972d-b82eb56dded6",
              "name": "CSV data containing query results. Check the Sforce-Locator response header for a locator token to retrieve subsequent pages.\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "query",
                    ":jobId",
                    "results"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "maxRecords",
                      "value": "10"
                    },
                    {
                      "key": "locator",
                      "value": "example_value"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
