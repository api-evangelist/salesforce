          "id": "bf97f7f6-9eb2-4385-b1f6-1bd17eb131a1",
          "name": "Salesforce Registration - Authorize",
          "request": {
            "name": "Salesforce Registration - Authorize",
            "description": {
              "content": "After you send your registration data to initialize, this request allows you to process that registration data, and as a part of this request you also verify the users email or sms number. The request itself is a authorization call for the Code and Credential flow. It includes 3 specific headers: `Auth-Request-Type` which is set to `user-registration`, `Auth-Verification-Type` which is set to email or sms, and an Authorization Basic header, which is the base 64 encoded result of `identifier:otp` where `identifier` is the value returned in your initialize registration call, and `otp` is the value sent to the end user via email or sms.\n\nThe response from this API is the Auth Code, which is then exchanged for the Access Token.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "services",
                "oauth2",
                "authorize"
              ],
              "host": [
                "login",
                "salesforce",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Required for User Registration",
                "key": "Auth-Request-Type",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Must match init/registration, email or sms",
                "key": "Auth-Verification-Type",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
