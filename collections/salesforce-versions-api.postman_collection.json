          "request": {
            "name": "Salesforce List Available Api Versions",
            "description": {
              "content": "Returns a list of all Salesforce REST API versions available on this instance. Each entry includes the version number, label, and URL. Use this to discover the latest supported version before building integrations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The Salesforce instance identifier (e.g., na1, eu3, or a My Domain subdomain like mycompany).\n",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                },
                {
                  "description": "The Salesforce API version number (e.g., 63.0). Use the latest supported version for new integrations.\n",
                  "type": "any",
                  "value": "{{version}}",
                  "key": "version"
                }
              ]
